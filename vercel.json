{
  "headers": [
    {
      "source": "/research/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; frame-src 'none'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/umfrage",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; frame-src 'none'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/research",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; frame-src 'none'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {"source":"/vermietung.html","destination":"/vermietung","permanent":true},
    {"source":"/ferienwohnungsmanagement.html","destination":"/ferienwohnungsmanagement","permanent":true},
    {"source":"/datenschutz.html","destination":"/datenschutz","permanent":true},
    {"source":"/research/admin.html","destination":"/research/admin","permanent":true},
    {"source":"/index.html","destination":"/","permanent":true},
    {"source":"/research/index.html","destination":"/research","permanent":true},
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bashkaran.ch"
        }
      ],
      "destination": "https://www.bashkaran.ch/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bashkaran.ch"
        }
      ],
      "destination": "https://www.bashkaran.ch/:path*",
      "permanent": true
    },
    {
      "source": "/umfrage",
      "destination": "/research",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source":"/research/de","destination":"/research/index.html"},
    {"source":"/research/en","destination":"/research/index.html"},
    {"source":"/vermietung","destination":"/vermietung.html"},
    {"source":"/ferienwohnungsmanagement","destination":"/ferienwohnungsmanagement.html"},
    {"source":"/datenschutz","destination":"/datenschutz.html"},
    {"source":"/research/admin","destination":"/research/admin.html"},
    {
      "source": "/research",
      "destination": "/research/index.html"
    }
  ]
}
